# Replace with the Askar store URI. Prefer a read-only database role.
ASKAR_EXPLORER_URI=postgres://readonly_user:REPLACE_ME@host.docker.internal:5432/mediator?sslmode=require

# Optional: uncomment only if you intend to apply reviewed change sets.
# This must point to the same store, using a role allowed to write.
# ASKAR_EXPLORER_WRITE_URI=postgres://writer:REPLACE_ME@host.docker.internal:5432/mediator?sslmode=require
